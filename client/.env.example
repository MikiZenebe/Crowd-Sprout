# CrowdSprout Client Environment Variables

# Deployed CrowdFunding Smart Contract address on Ethereum Sepolia
VITE_CONTRACT_ADDRESS=0xb7a8C4149e024ef4C957A901a006621aE0607585

# Dedicated Pinata IPFS Gateway domain (without https://)
VITE_GATEWAY_URL=your-gateway-name.mypinata.cloud

# Backend Presigned URL Server (Cloudflare Worker or Vercel Edge)
VITE_SERVER_URL=http://localhost:8787

# Optional: Etherscan API key for verifying contracts or fetching gas stats
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key_here
