# Ethereum Sepolia RPC URL (Alchemy / Infura / QuickNode)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key_here

# Deployer wallet private key (Do not commit real private keys!)
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_without_0x_prefix

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
